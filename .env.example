# Copy sang .env rồi điền giá trị thật. KHÔNG commit file .env.

# 01-function-calling — Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Tuỳ chọn: ghi đè model, mặc định gemini-flash-latest
GEMINI_MODEL=

# my-mcp-server — bearer token khi chạy transport streamable-http
MCP_AUTH_TOKEN=
